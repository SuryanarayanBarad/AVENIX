# ---------------------------------------------------------------------------
# QueueMind AI — environment template
# ---------------------------------------------------------------------------
# Copy to .env and fill in. Every value here is a PLACEHOLDER: never commit a
# real key, password, or connection string. .env itself is gitignored.
#
# In production these are set in the hosting dashboard (Render → Environment),
# not in a file.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# NODE_ENV: "production" on a deployed instance. Enables the safety checks that
# refuse to start on a development JWT_SECRET.
NODE_ENV="development"

# PORT: the port Express listens on. Hosts usually inject this themselves.
PORT="3000"

# APP_URL: the public URL this app is served from. Used for self-referential
# links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# JWT_SECRET: signs every session token. Anyone holding it can forge a token
# for ANY account, SUPER_ADMIN included — treat it like a root password.
# Generate with:  openssl rand -hex 32
# A production process refuses to start if this is left at the default.
JWT_SECRET="change-me-in-production"

# GEMINI_API_KEY: required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# UPLOAD_DIR: directory for stored profile/doctor photos when Supabase Storage
# is not configured. Only the served path is written to the database.
UPLOAD_DIR="./uploads"

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DATABASE_URL: pooled connection (Supabase port 6543) used by the running app.
#   Requires ?pgbouncer=true. connection_limit=10 lets independent queries run
#   in parallel; set it to 1 only for short-lived serverless functions.
# DIRECT_URL:  direct/session connection (port 5432), used ONLY by
#   `prisma migrate`. Poolers cannot run DDL.
# Percent-encode any of @ : / ? # & in the password (@ -> %40).

DATABASE_URL="postgresql://localhost:5432/queuemind"
DIRECT_URL="postgresql://localhost:5432/queuemind"

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
# From console.cloud.google.com/apis/credentials → OAuth 2.0 Client ID.
# GOOGLE_CLIENT_SECRET is server-side only and must never reach the browser.
#
# GOOGLE_REDIRECT_URI must be registered VERBATIM under "Authorised redirect
# URIs" on that same client, or Google answers 400 redirect_uri_mismatch.
# Register both the deployed and the local URL:
#   https://<your-app>.onrender.com/auth/google/callback
#   http://localhost:3000/auth/google/callback

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"

# ---------------------------------------------------------------------------
# Supabase (production database + image storage)
# ---------------------------------------------------------------------------

# SUPABASE_URL: your project URL, e.g. https://<ref>.supabase.co
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: SERVER-SIDE ONLY. Bypasses row-level security.
# Never prefix with VITE_ and never send it to the browser. Without this the
# app falls back to local disk, which does not survive a redeploy.
SUPABASE_SERVICE_ROLE_KEY=""

# SUPABASE_STORAGE_BUCKET: bucket holding uploaded images (public read).
SUPABASE_STORAGE_BUCKET="queue-images"

# ---------------------------------------------------------------------------
# Super admin bootstrap
# ---------------------------------------------------------------------------
# Used ONLY by `npx tsx prisma/bootstrap.ts` to create or repair the single
# SUPER_ADMIN account on a deployed database. The role cannot be granted
# through the API — this is the only path in.
# Set these transiently when bootstrapping, then clear them.

SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# SUPER_ADMIN_PASSWORD_RESET: startup repairs the SUPER_ADMIN *role* every boot,
# but never rewrites the password — otherwise whichever process started last
# would decide it, and a password changed in the app would revert on restart.
# To recover a lost password: set this to "true" for ONE boot, then remove it.
# SUPER_ADMIN_PASSWORD_RESET="true"

# ---------------------------------------------------------------------------
# Email (appointment + queue notifications)
# ---------------------------------------------------------------------------
# For Gmail, SMTP_PASS must be an App Password, not the account password.

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ---------------------------------------------------------------------------
# Web push notifications
# ---------------------------------------------------------------------------
# Generate a key pair with:  npx web-push generate-vapid-keys
# The private key is a secret; the public key is safe to ship to the browser.

VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:you@example.com"

# ---------------------------------------------------------------------------
# Escape hatches — leave unset
# ---------------------------------------------------------------------------

# ALLOW_LEGACY_ROLE_HEADER: re-enables the unauthenticated X-QueueMind-Role
# mock header on admin routes. A local demo escape hatch only; it must never be
# enabled in production.
# ALLOW_LEGACY_ROLE_HEADER="false"

# ALLOW_REMOTE_SEED: lets `prisma/seed.ts` run against a non-local database.
# The seed creates demo accounts with KNOWN passwords, so this must never be
# set against production. Use `npx tsx prisma/bootstrap.ts` there instead.
# ALLOW_REMOTE_SEED="true"

# SEED_SUPER_ADMIN_EMAIL: address for the local demo SUPER_ADMIN created by the
# seed. Local databases only — defaults to superadmin@local.test.
# SEED_SUPER_ADMIN_EMAIL="superadmin@local.test"
