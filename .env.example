# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for Prisma.
DATABASE_URL="postgresql://localhost:5432/queuemind"

# JWT_SECRET: Secret key for signing JWT tokens. Change in production.
JWT_SECRET="change-me-in-production"

# UPLOAD_DIR: Directory for stored profile/doctor photos.
# Defaults to ./uploads. Only the served path is written to the database.
UPLOAD_DIR="./uploads"

# ALLOW_LEGACY_ROLE_HEADER: Re-enables the unauthenticated X-QueueMind-Role
# mock header on admin routes. Leave unset (disabled) — it is a local demo
# escape hatch only, and must never be enabled in production.
# ALLOW_LEGACY_ROLE_HEADER="false"

# ---------------------------------------------------------------------------
# Supabase (production)
# ---------------------------------------------------------------------------
# DATABASE_URL: pooled connection (port 6543) used by the running app.
#   Requires ?pgbouncer=true. connection_limit=10 lets independent queries run
#   in parallel; set it to 1 only for short-lived serverless functions.
# DIRECT_URL:  direct/session connection (port 5432), used ONLY by
#   `prisma migrate`. Poolers cannot run DDL.
# Percent-encode any of @ : / ? # & in the password (@ -> %40).

# SUPABASE_URL: your project URL, e.g. https://<ref>.supabase.co
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: SERVER-SIDE ONLY. Bypasses row-level security.
# Never prefix with VITE_ and never send it to the browser. Without this the
# app falls back to local disk, which does not survive a redeploy.
SUPABASE_SERVICE_ROLE_KEY=""

# SUPABASE_STORAGE_BUCKET: bucket holding uploaded images (public read).
SUPABASE_STORAGE_BUCKET="queue-images"
